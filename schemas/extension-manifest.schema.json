{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkciphersystems.com/schemas/agentcontrol/extension-manifest-1.0.json",
  "title": "DarkCipher AgentControl extension manifest (SDK 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "publisher", "version", "minAppVersion", "sdkVersion", "types", "permissions", "license"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9\\-]*){1,6}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "maxLength": 1000 },
    "minAppVersion": { "$ref": "#/$defs/semver" },
    "maxTestedVersion": { "anyOf": [{ "$ref": "#/$defs/semver" }, { "const": "" }] },
    "sdkVersion": { "$ref": "#/$defs/semver" },
    "entryPoint": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.\\-]{1,100}\\.dll![A-Za-z_][A-Za-z0-9_.]{1,200}$" },
    "types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["AgentProvider", "Runtime", "ModelSource", "HardwareDetector", "Gateway", "StackTemplate", "RecommendationProvider", "CompatibilityTester", "ProjectIntegration", "ObservabilityIntegration", "DashboardPanel", "Command", "Importer", "Exporter"] }
    },
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["Network", "FileReads", "ProjectReads", "ProjectWrites", "ProcessExecution", "ModelManagement", "RuntimeManagement", "CredentialReferences", "UI", "Settings", "Logging", "Hardware", "Sessions"] }
    },
    "requiredServices": { "type": "array", "items": { "type": "string" } },
    "networkEndpoints": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "dependencies": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "minVersion"], "properties": { "id": { "type": "string" }, "minVersion": { "$ref": "#/$defs/semver" } } }
    },
    "license": { "type": "string", "minLength": 1 },
    "source": { "type": ["string", "null"], "pattern": "^https://" },
    "signature": { "type": ["string", "null"] },
    "contributes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stackTemplates": { "type": "array", "items": { "$ref": "#/$defs/relativeJson" } },
        "modelCatalogs": { "type": "array", "items": { "$ref": "#/$defs/relativeJson" } }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d{0,3})\\.(0|[1-9]\\d{0,4})\\.(0|[1-9]\\d{0,5})$" },
    "relativeJson": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)(?!.*\\\\)[^ ].*\\.json$", "maxLength": 199 }
  }
}
