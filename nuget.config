<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep every restored package inside this project tree (reproducible, offline-capable restores). -->
    <add key="globalPackagesFolder" value=".nuget\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Dependency-confusion guard: every package id must come from the single official feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
