<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Keep local build paths (user name) out of compiled output -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Windows x64 only. Declared everywhere so self-contained publishing does not change the lock files. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="'$(LockedRestore)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904;CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CA1000;CA1848;CA1716;CA1031;CA1002;CA2007;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1812;CA1822;CA1859;CA1805;CA2227;CA1819;CA1054;CA1055;CA1056;CA1063;CA1816;CA1001;CA2000;CA1711;CA1720;CA1724;CA1707;CA5394;CA1308;CA1865;CA1866;CA1847;CA1861;CA1869;CA2263;CA1860;CA1851;CA1508;CA1513;CA1510;CA1512;CA1725;CA1050;CA1028;CA1008;CA1027;CA1040;CA1034;CA1032;CA1064;CA2201;CA1068;CA1823;CA1806;CA2249;CA1845;CA1846;CA1827;CA1829;CA1868;CA1864;CA2208;CA1052;CA1047;CA1003;CA1813;CA1514</NoWarn>
    <Authors>darkcipher0x</Authors>
    <Company>DarkCipher Systems</Company>
    <Product>DarkCipher AgentControl</Product>
    <Copyright>Copyright © 2026 DarkCipher Systems</Copyright>
    <Version>0.1.10</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
