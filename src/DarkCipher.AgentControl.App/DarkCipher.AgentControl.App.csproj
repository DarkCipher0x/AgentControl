<Project Sdk="Microsoft.NET.Sdk">
  <!-- Presentation layer + composition root. Views and view models only; no business logic. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DarkCipherAgentControl</AssemblyName>
    <RootNamespace>DarkCipher.AgentControl.App</RootNamespace>
    <AssemblyTitle>DarkCipher AgentControl</AssemblyTitle>
    <Description>Configure, launch, monitor and manage agentic AI coding tools, local models and complete local coding stacks.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in the exe: Explorer, taskbar pinning, Start menu shortcuts. Generated by tools\build-icons.ps1. -->
    <ApplicationIcon>Assets\AppIcon\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DarkCipher.AgentControl.Domain\DarkCipher.AgentControl.Domain.csproj" />
    <ProjectReference Include="..\DarkCipher.AgentControl.Application\DarkCipher.AgentControl.Application.csproj" />
    <ProjectReference Include="..\DarkCipher.AgentControl.Security\DarkCipher.AgentControl.Security.csproj" />
    <ProjectReference Include="..\DarkCipher.AgentControl.Infrastructure\DarkCipher.AgentControl.Infrastructure.csproj" />
    <ProjectReference Include="..\DarkCipher.AgentControl.Integrations\DarkCipher.AgentControl.Integrations.csproj" />
    <ProjectReference Include="..\DarkCipher.AgentControl.Extensions\DarkCipher.AgentControl.Extensions.csproj" />
    <ProjectReference Include="..\DarkCipher.AgentControl.Sdk\DarkCipher.AgentControl.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DarkCipher.AgentControl.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window/title-bar/taskbar icon and the About card artwork (pack URIs in Appearance\ApplicationIconService.cs). -->
    <Resource Include="Assets\AppIcon\app.ico" />
    <Resource Include="Assets\AppIcon\app-256.png" />
    <None Include="Assets\AppIcon\app-master.svg" />
    <!-- Bundled, data-only gallery extensions (Extensions → Gallery). Packed and reviewed at install time. -->
    <None Include="Gallery\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
