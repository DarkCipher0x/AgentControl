<UserControl x:Class="DarkCipher.AgentControl.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,18">
        <ContentPresenter DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource PageHeader}"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0" ToolTip="Search message, component or correlation id"/>
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Width="140" Margin="0,0,8,0"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            <Button Content="Copy" Command="{Binding CopyCommand}"/>
            <Button Content="Export…" Command="{Binding ExportCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        <DataGrid ItemsSource="{Binding Entries}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsSmall}" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100"/>
                <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="90"/>
                <DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="140"/>
                <DataGridTextColumn Header="CORRELATION" Binding="{Binding Correlation}" Width="100"/>
                <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*"/>
                <DataGridTextColumn Header="ERROR" Binding="{Binding Exception}" Width="260"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
