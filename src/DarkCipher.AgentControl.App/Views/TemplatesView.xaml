<UserControl x:Class="DarkCipher.AgentControl.App.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:DarkCipher.AgentControl.App.Shell">
    <DockPanel Margin="{DynamicResource PageMargin}">
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Import…" Command="{Binding ImportCommand}"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>

        <!-- Selection -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,14,6" Width="170">
                    <TextBlock Text="AGENT" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Agent}" AutomationProperties.Name="Agent"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,6" Width="230">
                    <TextBlock Text="MODE" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Agent mode"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,6" Width="220">
                    <TextBlock Text="MODEL (installed, or type one)" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Models}" Text="{Binding Model, UpdateSourceTrigger=LostFocus}" IsEditable="True" FontFamily="{DynamicResource MonoFont}" AutomationProperties.Name="Model"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,6" Width="200">
                    <TextBlock Text="PROJECT" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" AutomationProperties.Name="Project"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,6" Width="190">
                    <TextBlock Text="PERMISSIONS" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding PermissionProfiles}" SelectedItem="{Binding Permission}" AutomationProperties.Name="Permission profile"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,6" Width="130">
                    <TextBlock Text="CONTEXT" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Contexts}" SelectedItem="{Binding Context}" AutomationProperties.Name="Context length"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,6" Width="140">
                    <TextBlock Text="REASONING" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding ReasoningLevels}" SelectedItem="{Binding Reasoning}" AutomationProperties.Name="Reasoning level"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" shell:ContextMenus.Provider="{Binding}" Margin="0,0,12,0" AutomationProperties.Name="Compatible templates">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource FgStrong}"/>
                                <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Origin, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Summary, Mode=OneWay}" Foreground="{Binding Brush}"/></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource CardTitle}"/>
                            <WrapPanel Margin="0,4,0,8">
                                <Button Content="Launch…" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" ToolTip="{Binding LaunchBlockedReason}"/>
                                <Button Content="Create stack" Command="{Binding CreateStackCommand}"/>
                                <Button Content="Dry run" Command="{Binding DryRunCommand}" ToolTip="Checks everything and shows what would happen. Writes and starts nothing."/>
                                <Button Content="Preview configuration" Command="{Binding PreviewCommand}"/>
                                <Button Content="Duplicate" Command="{Binding DuplicateCommand}"/>
                                <Button Content="Export" Command="{Binding ExportCommand}"/>
                                <Button Content="Reset to default" Command="{Binding ResetCommand}"/>
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding LaunchBlockedReason}" Style="{StaticResource BodySecondary}" Foreground="{DynamicResource Warn}"
                                       Visibility="{Binding LaunchBlockedReason, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Checks}" shell:ContextMenus.Provider="{Binding}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding FixLabel}" Style="{StaticResource SmallButton}"
                                                        Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Outcome}" Foreground="{Binding Brush}" FontWeight="SemiBold" Width="70"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="190" Style="{StaticResource Body}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource BodySecondary}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <TextBox Text="{Binding Output, Mode=OneWay}" Style="{StaticResource Console}" MinHeight="160" MaxHeight="460" AutomationProperties.Name="Template output"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
